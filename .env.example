# Database
DB_URL=jdbc:mysql://localhost:3306/tlias?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s

# JWT (use a Base64-encoded secret with at least 32 random bytes)
JWT_SIGN_KEY=replace-with-a-strong-base64-secret
JWT_EXPIRE_MS=43200000

# Aliyun OSS metadata
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=replace-with-your-bucket-name
OSS_REGION=cn-beijing

# Aliyun OSS credentials (read by the Aliyun SDK)
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret

# Optional: only used by the manual OSS demo under src/test
OSS_TEST_FILE=replace-with-an-existing-local-file-path
