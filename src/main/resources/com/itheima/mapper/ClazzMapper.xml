<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.ClazzMapper">
    <update id="updateById">
        update clazz
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="room != null">
                room = #{room},
            </if>
            <if test="beginDate != null">
                begin_date = #{beginDate},
            </if>
            <if test="endDate != null">
                end_date = #{endDate},
            </if>
            <if test="masterId != null">
                master_id = #{masterId},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="list" resultType="com.itheima.pojo.Clazz">
        select c.*, e.name as masterName
        from clazz c left outer join emp e on e.id = c.master_id
        <where>
            <if test="name != null and name != ''">
                c.name like concat('%',#{name},'%')
            </if>
            <if test="begin != null">
                and c.begin_date >= #{begin}
            </if>
            <if test="end != null">
                and  c.end_date <![CDATA[<=]]> #{end}
            </if>
        </where>
        order by c.id
    </select>
</mapper>